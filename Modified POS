sys.path.insert(0, "./SkinDetector")
import skin_detector  # noqa: E402

# Official MediaPipe model bundle for the Face Landmarker task (478 3D
# landmarks). This replaces dlib's frontal HOG detector, which loses the
# face entirely on head-turns, blur, or uneven lighting -- MediaPipe's
# model is far more tolerant of all three, which directly reduces the
# long MISSING-frame runs that were corrupting the RGB trace.
FACE_LANDMARKER_MODEL_URL = (
    "https://storage.googleapis.com/mediapipe-models/face_landmarker/"
    "face_landmarker/float16/1/face_landmarker.task"
)

import matplotlib

