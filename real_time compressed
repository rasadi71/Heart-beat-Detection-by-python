# NEW: main capture loop
# =============================================================================

def open_camera(camera_index, use_dshow=True, fourcc="YUY2"):
    """
    Open a live camera, requesting an uncompressed pixel format instead
    of whatever the driver defaults to (commonly MJPEG, which is
    already-compressed and can introduce compression artifacts into the
    RGB trace before the algorithm ever sees it).

    On Windows, cv2.CAP_DSHOW (DirectShow) is what lets OpenCV actually
    honor a CAP_PROP_FOURCC request like YUY2 -- the default backend
    often ignores it and silently keeps MJPEG. This only applies to a
    live camera (--video file playback is unaffected either way, since a
    file's encoding is already fixed).

    On non-Windows platforms CAP_DSHOW doesn't exist, so this falls back
    to the default backend; FOURCC is still requested but the OS/driver
    may or may not honor it (Linux's V4L2 backend generally does support
    an explicit FOURCC request, e.g. 'YUYV').
    """
    if use_dshow and sys.platform.startswith("win"):
        camera = cv2.VideoCapture(camera_index, cv2.CAP_DSHOW)
    else:
        camera = cv2.VideoCapture(camera_index)

    if fourcc:
        try:
            camera.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*fourcc))
        except Exception as e:
            print(f"WARNING: could not request FOURCC '{fourcc}' ({e}); "
                  f"continuing with the camera's default format.")

    return camera


def _gui_available():
    """Probe whether this OpenCV build actually has a GUI backend (GTK/Qt/
    Cocoa/Win32) compiled in. Headless builds (e.g. many conda-forge
    libopencv installs, or opencv-python-headless) raise cv2.error with
    'not implemented' the moment imshow/destroyAllWindows is called -- so
    we check once up front rather than crashing mid-stream."""
    try:
        cv2.namedWindow("__gui_probe__", cv2.WINDOW_NORMAL)
        cv2.destroyWindow("__gui_probe__")
        return True
    except cv2.error:
        return False


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-v", "--video",
                     help="optional video file to stream instead of a live "
                          "camera (paced to real time via sleep, so the "
                          "same 1s-per-window schedule applies)")
    ap.add_argument("--camera_index", type=int, default=0,
                     help="camera device index to use when --video is not given")
    ap.add_argument("--framerate", type=float, default=30.0,
                     help="nominal capture framerate; must match the camera's "
                          "actual rate for the HR math to be correct")
    ap.add_argument("--face_model", default="face_landmarker.task")
    ap.add_argument("--no_color_skin_mask", action="store_true")
    ap.add_argument("--window_seconds", type=float, default=1.6,
                     help="POS sliding-window length in seconds (paper default 1.6s)")
    ap.add_argument("--pos_combine", choices=["alpha", "svd"], default="alpha")
    ap.add_argument("--low_hz", type=float, default=0.7)
    ap.add_argument("--high_hz", type=float, default=3.5)
    ap.add_argument("--max_gap", type=int, default=5,
                     help="max consecutive frames to bridge with the last known face box")
    ap.add_argument("--nsegments", type=int, default=12)
    ap.add_argument("--start_display_at", type=float, default=11.0,
                     help="second at which the first HR value is computed/shown")
    ap.add_argument("--buffer_seconds", type=float, default=10.0,
                     help="width of the rolling window in seconds (default 10s)")
    ap.add_argument("--image_show", action="store_true",
                     help="show a live window with the camera feed and HR overlay")
    ap.add_argument("--fourcc", default="YUY2",
                     help="pixel format to request from a live camera (default "
                          "YUY2, uncompressed). Pass '' to leave the camera's "
                          "default (often MJPEG) untouched.")
    ap.add_argument("--no_dshow", action="store_true",
                     help="on Windows, don't force the DirectShow backend "
                          "(needed for --fourcc to actually take effect there)")
    args = ap.parse_args()

    if args.video:
        camera = cv2.VideoCapture(args.video)
        is_file = True
    else:
        camera = open_camera(args.camera_index, use_dshow=not args.no_dshow,
                              fourcc=args.fourcc)
        is_file = False
    if not camera.isOpened():
        raise RuntimeError("Cannot open video source.")

    model_path = ensure_face_landmarker_model(args.face_model)
    landmarker = build_face_landmarker(model_path)

    monitor = RealTimeHeartRateMonitor(
        framerate=args.framerate,
        start_display_at=args.start_display_at,
        buffer_seconds=args.buffer_seconds,
        window_seconds=args.window_seconds,
        pos_combine=args.pos_combine,
        low_hz=args.low_hz,
        high_hz=args.high_hz,
        nsegments=args.nsegments,
    )

    # MediaPipe's VIDEO mode requires a strictly monotonically increasing
    # timestamp_ms. We use real wall-clock elapsed time (matching the
    # same clock the trace timestamps use), with a tiny fallback bump in
    # the rare case two frames land in the same millisecond.
    last_timestamp_ms = -1
    last_landmarks_px = None
    gap_count = 0
    frame_interval = 1.0 / args.framerate

    image_show = args.image_show
    if image_show and not _gui_available():
        print("WARNING: --image_show was requested but this OpenCV build "
              "has no GUI backend (headless build -- see error you'd "
              "otherwise get from cv2.imshow). Falling back to console-only "
              "output. To fix: pip uninstall opencv-python-headless -y && "
              "pip install opencv-python (or `conda install -c conda-forge "
              "opencv` in a conda env).")
        image_show = False

    print(f"Streaming... collecting baseline for {args.start_display_at:.0f}s "
          f"before the first HR estimate is shown.")

    monitor.start()
    try:
        while True:
            loop_start = time.time()

            grabbed, frame = camera.read()
            if not grabbed:
                print("End of stream / camera read failed.")
                break

            timestamp_ms = int(round((time.time() - monitor.start_time) * 1000.0))
            if timestamp_ms <= last_timestamp_ms:
                timestamp_ms = last_timestamp_ms + 1
            last_timestamp_ms = timestamp_ms

            rgb, last_landmarks_px, gap_count = process_single_frame(
                frame, landmarker, timestamp_ms, last_landmarks_px, gap_count,
                args.max_gap, use_color_skin_mask=not args.no_color_skin_mask,
                image_show=image_show,
            )

            if rgb is None:
                # No face yet at all (startup) -- nothing usable to append.
                # Once a face has been seen at least once, causally reuse
                # the last valid sample instead of waiting for a future
                # frame to interpolate against (there is no "future" in
                # real time).
                if monitor.n_samples() > 0:
                    with monitor._lock:
                        rgb = tuple(monitor._trace[-1])

            if rgb is not None:
                monitor.append_sample(rgb)

            if image_show:
                elapsed = time.time() - monitor.start_time
                if monitor.current_hr is not None:
                    label = f"HR: {monitor.current_hr:.1f} bpm"
                    color = (0, 255, 0)
                else:
                    remaining = max(0.0, args.start_display_at - elapsed)
                    label = f"Collecting baseline... {remaining:.1f}s"
                    color = (0, 165, 255)
                cv2.putText(frame, label, (10, 30), cv2.FONT_HERSHEY_SIMPLEX,
                            0.9, color, 2, cv2.LINE_AA)
                try:
                    cv2.imshow("Real-time rPPG", frame)
                    if cv2.waitKey(1) & 0xFF == ord("q"):
                        break
                except cv2.error as e:
                    print(f"WARNING: display window failed ({e}); "
                          f"continuing in console-only mode.")
                    image_show = False

            if is_file:
                # Pace file playback to real time so the 1s-per-window
                # schedule behaves the same as it would with a live camera.
                elapsed_loop = time.time() - loop_start
                sleep_left = frame_interval - elapsed_loop
                if sleep_left > 0:
                    time.sleep(sleep_left)
    except KeyboardInterrupt:
        print("Interrupted by user.")
    finally:
        monitor.stop()
        camera.release()
        landmarker.close()
        if image_show:
            try:
                cv2.destroyAllWindows()
            except cv2.error:
                pass

    if monitor.current_hr is not None:
        print(f"Final displayed heart rate: {monitor.current_hr:.2f} bpm")
    else:
        print("Stream ended before the first HR estimate could be computed "
              f"(needs >= {args.start_display_at:.0f}s of footage with a "
              "detected face).")


if __name__ == "__main__":
    main()
